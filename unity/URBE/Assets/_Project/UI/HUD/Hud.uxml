<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:VisualElement name="stats" class="stats">
                <ui:VisualElement name="vehicles-chip" class="chip">
                    <ui:Label text="Vehículos" class="chip-caption" />
                    <ui:Label name="vehicle-count" text="0" class="chip-value" />
                </ui:VisualElement>
                <ui:VisualElement name="flow-chip" class="chip">
                    <ui:Label text="Flujo" class="chip-caption" />
                    <ui:Label name="flow-value" text="100%" class="chip-value" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="speed-controls" class="speed-controls">
                <ui:Button name="btn-pause" text="II" class="hud-button" />
                <ui:Button name="btn-x1" text="x1" class="hud-button" />
                <ui:Button name="btn-x2" text="x2" class="hud-button" />
                <ui:Button name="btn-x3" text="x3" class="hud-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottom-area" class="bottom-area" picking-mode="Ignore">
            <ui:VisualElement name="loupe" class="loupe" picking-mode="Ignore" />
            <ui:Label name="tool-message" class="tool-message" picking-mode="Ignore" text="" />
            <ui:VisualElement name="road-panel" class="road-panel">
                <ui:VisualElement class="tool-group">
                    <ui:Button name="btn-type-street" text="Calle" class="hud-button tool-button" />
                    <ui:Button name="btn-type-avenue" text="Avenida" class="hud-button tool-button" />
                </ui:VisualElement>
                <ui:VisualElement class="tool-group">
                    <ui:Button name="btn-mode-straight" text="Recta" class="hud-button tool-button" />
                    <ui:Button name="btn-mode-curve" text="Curva" class="hud-button tool-button" />
                    <ui:Button name="btn-mode-free" text="Libre" class="hud-button tool-button" />
                    <ui:Button name="btn-mode-demolish" text="Demoler" class="hud-button tool-button" />
                </ui:VisualElement>
                <ui:VisualElement class="tool-group">
                    <ui:Button name="btn-undo" text="Deshacer" class="hud-button tool-button" />
                    <ui:Button name="btn-cancel" text="X" class="hud-button tool-button tool-cancel" />
                    <ui:Button name="btn-confirm" text="OK" class="hud-button tool-button tool-confirm" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-row" class="bottom-row" picking-mode="Ignore">
                <ui:Button name="btn-build" text="Construir" class="hud-button tool-button build-toggle" />
                <ui:Button name="btn-traffic" text="Trafico" class="hud-button tool-button traffic-toggle" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
